<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {% endif %}
    {% render 'meta-tags' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {% # theme-check-disable RemoteAsset %}
    <link href="https://fonts.googleapis.com/css2?family=Titan+One&family=Yellowtail&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet">
    {% # theme-check-enable RemoteAsset %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --navy: {{ settings.color_navy | default: '#1c2f6b' }};
        --yellow: {{ settings.color_yellow | default: '#f7c623' }};
        --red: {{ settings.color_red | default: '#d62b2b' }};
        --cream: {{ settings.color_cream | default: '#f7f1e6' }};
      }
    </style>
    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#app">Aller au contenu</a>
    {% sections 'header-group' %}

    <main id="app" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div class="overlay" id="overlay" hidden></div>
    <aside class="drawer" id="cartDrawer" aria-label="Panier" aria-hidden="true"></aside>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      window.SGDD_CFG = {
        freeShipCents: {{ settings.free_shipping_threshold | times: 100 | json }},
        collect: {{ settings.click_collect | json }},
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          root: {{ routes.root_url | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
