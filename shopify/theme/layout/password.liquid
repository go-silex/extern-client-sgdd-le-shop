<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} | Bientôt en ligne</title>
    {% # theme-check-disable RemoteAsset %}
    <link href="https://fonts.googleapis.com/css2?family=Titan+One&family=Yellowtail&family=DM+Sans:opsz,wght@9..40,400;9..40,700&display=swap" rel="stylesheet">
    {% # theme-check-enable RemoteAsset %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    {{ content_for_layout }}
  </body>
</html>
