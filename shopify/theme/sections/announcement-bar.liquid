{%- if section.blocks.size > 0 -%}
  <div class="topbar" {{ section.shopify_attributes }}>
    {%- for block in section.blocks -%}
      {%- unless forloop.first -%}<span class="dot" aria-hidden="true">★</span>{%- endunless -%}
      <span {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </span>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d'annonce",
  "class": "section-announcement",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte dès 80 €" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [{ "name": "Bandeau d'annonce", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
