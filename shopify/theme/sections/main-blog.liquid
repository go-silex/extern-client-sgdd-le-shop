<div class="wrap">
  <div class="page-head"><h1 class="page-title">{{ blog.title }}</h1></div>
  {%- paginate blog.articles by 12 -%}
    <div class="grid" style="margin-bottom:60px">
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          <div class="card-media">{%- if article.image -%}{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}{%- endif -%}</div>
          <div class="card-body"><div class="card-type">{{ article.published_at | date: '%d/%m/%Y' }}</div><div class="card-name">{{ article.title }}</div></div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
