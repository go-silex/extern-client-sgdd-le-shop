<header class="header">
  <div class="header-inner">
    <button class="icon-btn menu-btn" type="button" aria-label="Menu" data-action="menu">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    {% render 'logo' %}
    <nav class="nav" id="nav" aria-label="Menu principal">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} class="active" aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">Tout le shop</a>
      {%- endfor -%}
    </nav>
    <div class="header-actions">
      <button class="icon-btn" type="button" aria-label="Rechercher" data-action="search">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <a class="icon-btn cart-btn" href="{{ routes.cart_url }}" aria-label="Panier" data-action="cart">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 8V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <span class="cart-count" id="cartCount">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  <div class="search-bar" id="searchBar" hidden>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" placeholder="Hoodie, casquette, skate..." aria-label="Rechercher un article">
      <input type="hidden" name="type" value="product">
    </form>
  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
