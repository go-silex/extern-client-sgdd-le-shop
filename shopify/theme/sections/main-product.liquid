{%- liquid
  assign current = product.selected_or_first_available_variant
  assign contain = false
  if product.type == 'Skate' or product.type == 'Déco' or product.type == 'Surf'
    assign contain = true
  endif
  assign badge = ''
  for tag in product.tags
    if tag contains 'badge:'
      assign badge = tag | remove: 'badge:'
    endif
  endfor
-%}
<div class="wrap" data-product-section>
  <div class="crumbs" style="padding-top:26px">
    <a href="{{ routes.root_url }}">Accueil</a> /
    {%- if collection %} <a href="{{ collection.url }}">{{ collection.title }}</a> /{% endif %} {{ product.title }}
  </div>
  <div class="pdp">
    <div>
      <div class="gallery-main{% if contain %} contain{% endif %}">
        {%- unless product.available -%}<span class="badge badge-out">Épuisé</span>{%- else -%}{%- if badge != blank -%}<span class="badge">{{ badge }}</span>{%- endif -%}{%- endunless -%}
        {%- if product.gift_card? and product.featured_image == blank -%}
          {% render 'giftcard-visual' %}
        {%- else -%}
          {%- assign main_img = current.featured_image | default: product.featured_image -%}
          {%- if main_img -%}{{ main_img | image_url: width: 1100 | image_tag: id: 'pdpMain', loading: 'eager', widths: '500, 800, 1100', sizes: '(min-width: 900px) 55vw, 100vw', alt: product.title }}{%- endif -%}
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="gallery-thumbs">
          {%- for image in product.images -%}
            <button type="button" class="{% if image.id == main_img.id %}active{% endif %}" data-thumb="{{ image | image_url: width: 1100 }}" data-image-id="{{ image.id }}" aria-label="Photo {{ forloop.index }}">
              {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp-info">
      <div class="card-type">{{ product.type }}</div>
      <h1>{{ product.title }}</h1>
      <div class="pdp-price" data-price>{{ current.price | money }}</div>
      <p class="low-stock" data-low-stock hidden></p>
      <div class="pdp-desc rte">{{ product.description }}</div>

      {%- form 'product', product, class: 'js-product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="opt-group" data-option-index="{{ forloop.index0 }}">
              <div class="opt-label">{{ option.name }} <span data-option-value>{{ option.selected_value }}</span></div>
              <div class="{% if option.name == 'Couleur' or option.name == 'Montant' %}color-opts{% else %}size-opts{% endif %}">
                {%- for value in option.values -%}
                  {%- if option.name == 'Couleur' -%}
                    {%- capture hex %}{% render 'swatch-color', name: value %}{% endcapture -%}
                    <button type="button" class="color-opt{% if option.selected_value == value %} active{% endif %}" style="background:{{ hex | strip | default: '#ddd' }}" data-value="{{ value | escape }}" aria-label="{{ value | escape }}" title="{{ value | escape }}"></button>
                  {%- elsif option.name == 'Montant' -%}
                    <button type="button" class="size-opt{% if option.selected_value == value %} active{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
                  {%- else -%}
                    <button type="button" class="size-opt{% if option.selected_value == value %} active{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="buy-row">
          <div class="qty"><button type="button" data-qty="-1" aria-label="Moins">−</button><input type="number" name="quantity" value="1" min="1" aria-label="Quantité" data-qty-input><button type="button" data-qty="1" aria-label="Plus">+</button></div>
          <button class="btn btn-primary" type="submit" name="add" data-add-button {% unless current.available %}disabled{% endunless %}>
            {%- if current.available -%}Ajouter au panier{%- else -%}Épuisé{%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <div class="pdp-perks">
        <div>✉️ <span><b>Commande sans paiement en ligne</b> : Marco vous recontacte pour le règlement</span></div>
        {%- if settings.click_collect -%}<div>🏄 <span><b>Retrait gratuit</b> au 7 place de Verdun</span></div>{%- endif -%}
        <div>📦 <span><b>Livraison offerte</b> dès {{ settings.free_shipping_threshold }} €</span></div>
      </div>
      <details class="acc"><summary>Livraison & retours</summary><p>Retrait gratuit en boutique ou envoi en Colissimo après règlement. Échange ou remboursement sous 30 jours, article non porté.</p></details>
    </div>
  </div>

  {%- liquid
    assign related_source = collection | default: product.collections.first
  -%}
  {%- if related_source and related_source.products_count > 1 -%}
    <div class="section-head"><div><span class="script">Dans le même rayon</span><h2>Ça va bien avec</h2></div></div>
    <div class="grid">
      {%- assign shown = 0 -%}
      {%- for p in related_source.products limit: 6 -%}
        {%- if p.id != product.id and shown < 4 -%}
          {% render 'product-card', product: p %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  <div style="height:80px"></div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
  <script type="application/json" data-inventory-json>
    {
      {%- for v in product.variants -%}
        "{{ v.id }}": {% if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' %}{{ v.inventory_quantity }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
</div>

{% schema %}
{
  "name": "Fiche produit",
  "settings": []
}
{% endschema %}
