{%- paginate collection.products by 24 -%}
  <div class="wrap">
    <div class="page-head">
      <div class="crumbs"><a href="{{ routes.root_url }}">Accueil</a> / {{ collection.title }}</div>
      <h1 class="page-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
    </div>
    <div class="filters">
      <a class="chip{% if collection.handle == 'all' %} active{% endif %}" href="{{ routes.all_products_collection_url }}">Tout</a>
      {%- for link in section.settings.menu.links -%}
        <a class="chip{% if link.active %} active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      <span class="spacer"></span>
      <label class="visually-hidden" for="SortBy">Trier</label>
      <select id="SortBy" data-sort>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </div>
    <p class="result-count">{{ collection.products_count }} article{% if collection.products_count > 1 %}s{% endif %}</p>
    {%- if collection.products.size > 0 -%}
      <div class="grid">
        {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty"><p>Aucun article pour le moment.</p></div>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pages">{{ paginate | default_pagination: next: 'Suivant →', previous: '← Précédent' }}</nav>{%- endif -%}
    <div style="height:80px"></div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Raccourcis vers les rayons", "default": "main-menu" }
  ]
}
{% endschema %}
