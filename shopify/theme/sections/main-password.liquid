<div class="adm-login">
  <div class="adm-login-card">
    {% render 'logo', size: 'lg' %}
    <h1>Bientôt en ligne</h1>
    <p>{{ shop.password_message | default: "La boutique en ligne ouvre très vite. En attendant, on vous attend place de Verdun." }}</p>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prelancement">
      {%- if form.posted_successfully? -%}
        <p class="news-ok">Merci, on vous prévient à l'ouverture.</p>
      {%- else -%}
        <div class="field"><input type="email" name="contact[email]" required placeholder="Votre email pour être prévenu" aria-label="Email"></div>
        <button class="btn btn-primary btn-block" type="submit">Me prévenir</button>
      {%- endif -%}
    {%- endform -%}
    <details class="acc" style="margin-top:18px;text-align:left">
      <summary>Accès gérant</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-error">Mot de passe incorrect.</p>{%- endif -%}
        <div class="field" style="margin-top:10px"><input type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe" autocomplete="current-password"></div>
        <button class="btn btn-secondary btn-block" type="submit">Entrer</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{ "name": "Page d'attente", "settings": [] }
{% endschema %}
