{%- comment -%} Returns the hex for a colour name from the theme setting (renders nothing if unknown). {%- endcomment -%}
{%- assign lines = settings.color_swatches | newline_to_br | split: '<br />' -%}
{%- for line in lines -%}
  {%- assign pair = line | strip | split: ':' -%}
  {%- if pair[0] == name -%}{{ pair[1] | strip }}{%- break -%}{%- endif -%}
{%- endfor -%}
